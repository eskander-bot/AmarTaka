<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Amar Taka · আজকের ব্যয়" android:textColor="#DDF6ED" android:textSize="13sp"/>
    <TextView android:id="@+id/widget_amount" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="অ্যাপ খুলুন" android:textColor="#FFFFFF" android:textSize="22sp" android:maxLines="2"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/widget_income" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="+ আয়" android:textColor="#FFFFFF" android:backgroundTint="#18745C"/>
        <Button android:id="@+id/widget_expense" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="− ব্যয়" android:textColor="#FFFFFF" android:backgroundTint="#18745C"/>
    </LinearLayout>
</LinearLayout>
